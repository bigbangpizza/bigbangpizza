# Copie este arquivo para ".env" e preencha os valores reais.
# Nenhuma chave real deve ir para o .env.example nem para o git.

PORT=3000

# ── Evolution API (sua instância self-hosted ou Evolution Cloud) ──────────
EVOLUTION_API_URL=https://sua-instancia-evolution.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=bigbangpizza

# ── Claude API (Anthropic) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Modelos disponíveis atualmente: claude-opus-5, claude-sonnet-5,
# claude-haiku-4-5-20251001. Sonnet é o equilíbrio recomendado entre
# qualidade e custo para atendimento; Haiku é mais barato para alto volume.
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=700

# ── Groq (transcrição de áudio — Whisper) ──────────────────────────────────
# https://console.groq.com — tier gratuito generoso, ver README.md
GROQ_API_KEY=

# ── Supabase (mesmo projeto do site — leitura pública do cardápio) ────────
# Os valores estão em index.html/admin.html (const SB / const SK) — é a
# chave pública ("publishable"), não é secreta, mas mesmo assim não vem
# preenchida aqui por padrão.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ⚠️ CHAVE PRIVILEGIADA — NÃO CONFUNDIR COM A ANON KEY ACIMA ⚠️
# service_role key (Project Settings → API → "service_role" / "secret" key no
# Supabase). Ela IGNORA todas as políticas de RLS — dá acesso total de
# leitura/escrita em qualquer tabela, de qualquer cliente. Usada pelas
# rotinas agendadas que precisam ler dados que a chave pública não pode
# (pedidos só permite INSERT anônimo; avaliações não permite UPDATE anônimo),
# e também por botConfig.js pra ler a aba "Configurações do Bot" do admin.html:
#   - reactivationJob.js   (reativação automática de clientes "em risco")
#   - delayedOrdersJob.js  (alerta de pedido atrasado)
#   - badReviewsJob.js     (alerta de avaliação com nota baixa)
#   - abandonedCartJob.js  (recuperação de carrinho abandonado)
# Sem essa variável, o bot funciona 100% normal — só essas rotinas ficam
# desativadas (loga um aviso e não agenda os crons). Nunca compartilhe essa
# chave, nunca cole em chat/log, nunca commite em nenhum arquivo.
SUPABASE_SERVICE_ROLE_KEY=

# Minutos que um pedido pode ficar parado em "Aguardando"/"Aceito/Preparando"
# antes do delayedOrdersJob.js avisar o Gabriel. Usado só como valor padrão
# — a aba "Configurações do Bot" do admin.html sobrescreve isso em tempo
# real (tabela `configuracoes`, chave `pedido_atraso_minutos`), sem precisar
# mexer aqui nem reiniciar o bot.
PEDIDO_ATRASO_MINUTOS=40

# Minutos parado desde a criação do carrinho (sem finalizar o pedido) antes
# do abandonedCartJob.js mandar a mensagem de recuperação pro cliente.
ABANDONED_CART_MINUTOS=25

# Duas janelas usadas pra evitar pedido duplicado (ver orderTool.js e
# systemPrompt.js) — cenário típico: cliente fecha o pedido pelo site e em
# seguida manda a mensagem pré-preenchida do WhatsApp, que sem essa proteção
# o bot processava como um pedido novo. As duas checagens exigem
# SUPABASE_SERVICE_ROLE_KEY configurada acima (sem ela, ficam desativadas e
# o bot funciona normalmente, só sem essa proteção extra).
#   - CONTEXTO: janela maior só pra avisar a Claude que existe um pedido em
#     aberto recente, deixando ela decidir com bom senso se é o mesmo pedido
#     ou um pedido novo de verdade.
#   - BLOQUEIO: janela menor e mais estrita — rede de segurança técnica que
#     recusa o INSERT se os itens e o bairro forem exatamente iguais aos de
#     um pedido em aberto recente (comparação exata, não uma regra vaga).
PEDIDO_DUPLICADO_CONTEXTO_MINUTOS=20
PEDIDO_DUPLICADO_BLOQUEIO_MINUTOS=10

# Segundos que o cardápio/bairros ficam em cache em memória antes de buscar
# de novo no Supabase (evita bater no banco a cada mensagem recebida).
MENU_CACHE_TTL_SECONDS=300

# Quantas mensagens (usuário + assistente) manter de histórico por contato,
# para dar contexto de conversa (vale tanto pro Redis quanto pro fallback em
# memória, ver REDIS_URL abaixo).
HISTORY_MAX_MESSAGES=12

# ── Redis (histórico de conversa persistente) ──────────────────────────────
# Mesmo serviço Redis já provisionado no Railway junto com a Evolution API
# (redis://... ou rediss://... se usar TLS) — no Railway, adicione essa
# variável no serviço whatsapp-bot como uma "Variable Reference" apontando
# pro serviço Redis existente (algo como ${{Redis.REDIS_URL}}, o nome exato
# aparece na aba Variables do próprio serviço Redis). NÃO é obrigatória pra
# subir o servidor: sem ela (ou se a conexão falhar por qualquer motivo), o
# histórico de conversa funciona só em memória — sobrevive enquanto o
# processo estiver de pé, mas some a cada redeploy/restart. Ver
# src/historicoRedis.js.
REDIS_URL=

# Opcional, mas recomendado: string aleatória usada para validar que o
# webhook realmente veio da sua instância Evolution API. Configure a URL do
# webhook na Evolution API como:
#   https://seu-bot.exemplo.com/webhook?secret=SEU_SEGREDO_AQUI
WEBHOOK_SECRET=

# Mesma ideia do WEBHOOK_SECRET acima, mas pro endpoint /alerta-uptime (ver
# "Monitoramento externo (UptimeRobot)" no README.md pro passo a passo
# completo de como configurar o alert contact no painel do UptimeRobot).
# Configure lá a URL do webhook como:
#   https://seu-bot.exemplo.com/alerta-uptime?secret=SEU_SEGREDO_AQUI
UPTIME_WEBHOOK_SECRET=

# Minutos que o bot fica em silêncio pra um número depois de detectar que
# um humano (Gabriel/equipe) respondeu manualmente pelo WhatsApp conectado
# (em vez de deixar o bot responder por cima) — ver src/atendimentoHumanoUtil.js.
# Passado esse tempo, a próxima mensagem do cliente volta a ser respondida
# normalmente pelo bot.
HUMAN_TAKEOVER_PAUSA_MINUTOS=45

# ── Notificações internas para o Gabriel ───────────────────────────────────
# Número do Gabriel (só dígitos, com DDI 55 — ex: 5571999999999). Recebe 4
# tipos de aviso: pedido aguardando link de pagamento Ton, pedido atrasado,
# avaliação com nota baixa, e bot fora do ar (UptimeRobot, ver acima). Usado
# só como valor padrão — a aba "Configurações do Bot" do admin.html
# sobrescreve isso em tempo real (tabela `configuracoes`, chave
# `alerta_whatsapp_numero`), sem precisar mexer aqui nem reiniciar o bot.
# Sem essa variável nem o campo preenchido no admin, tudo mais continua
# funcionando normalmente — só esses avisos não são enviados (loga no
# servidor em vez de travar qualquer fluxo).
GABRIEL_WHATSAPP_NUMBER=
