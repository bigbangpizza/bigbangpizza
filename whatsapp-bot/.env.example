# Copie este arquivo para ".env" e preencha os valores reais.
# Nenhuma chave real deve ir para o .env.example nem para o git.

PORT=3000

# ── Evolution API (sua instância self-hosted ou Evolution Cloud) ──────────
EVOLUTION_API_URL=https://sua-instancia-evolution.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=bigbangpizza

# ── Claude API (Anthropic) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Modelos disponíveis atualmente: claude-opus-5, claude-sonnet-5,
# claude-haiku-4-5-20251001. Sonnet é o equilíbrio recomendado entre
# qualidade e custo para atendimento; Haiku é mais barato para alto volume.
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=700

# ── Groq (transcrição de áudio — Whisper) ──────────────────────────────────
# https://console.groq.com — tier gratuito generoso, ver README.md
GROQ_API_KEY=

# ── Supabase (mesmo projeto do site — leitura pública do cardápio) ────────
# Os valores estão em index.html/admin.html (const SB / const SK) — é a
# chave pública ("publishable"), não é secreta, mas mesmo assim não vem
# preenchida aqui por padrão.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ⚠️ CHAVE PRIVILEGIADA — NÃO CONFUNDIR COM A ANON KEY ACIMA ⚠️
# service_role key (Project Settings → API → "service_role" / "secret" key no
# Supabase). Ela IGNORA todas as políticas de RLS — dá acesso total de
# leitura/escrita em qualquer tabela, de qualquer cliente. Usada pelas 3
# rotinas agendadas que precisam ler dados que a chave pública não pode
# (pedidos só permite INSERT anônimo; avaliações não permite UPDATE anônimo):
#   - reactivationJob.js   (reativação automática de clientes "em risco")
#   - delayedOrdersJob.js  (alerta de pedido atrasado)
#   - badReviewsJob.js     (alerta de avaliação com nota baixa)
# Sem essa variável, o bot funciona 100% normal — só essas 3 rotinas ficam
# desativadas (loga um aviso e não agenda os crons). Nunca compartilhe essa
# chave, nunca cole em chat/log, nunca commite em nenhum arquivo.
SUPABASE_SERVICE_ROLE_KEY=

# Minutos que um pedido pode ficar parado em "Aguardando"/"Aceito/Preparando"
# antes do delayedOrdersJob.js avisar o Gabriel. Ajustável sem mexer em
# código — só mudar esse valor e reiniciar o bot.
PEDIDO_ATRASO_MINUTOS=40

# Minutos parado desde a criação do carrinho (sem finalizar o pedido) antes
# do abandonedCartJob.js mandar a mensagem de recuperação pro cliente.
ABANDONED_CART_MINUTOS=25

# Segundos que o cardápio/bairros ficam em cache em memória antes de buscar
# de novo no Supabase (evita bater no banco a cada mensagem recebida).
MENU_CACHE_TTL_SECONDS=300

# Quantas mensagens (usuário + assistente) manter de histórico por contato,
# em memória, para dar contexto de conversa.
HISTORY_MAX_MESSAGES=12

# Opcional, mas recomendado: string aleatória usada para validar que o
# webhook realmente veio da sua instância Evolution API. Configure a URL do
# webhook na Evolution API como:
#   https://seu-bot.exemplo.com/webhook?secret=SEU_SEGREDO_AQUI
WEBHOOK_SECRET=

# ── Notificações internas para o Gabriel ───────────────────────────────────
# Número do Gabriel (só dígitos, com DDI 55 — ex: 5571999999999). Recebe 3
# tipos de aviso: pedido aguardando link de pagamento Ton, pedido atrasado, e
# avaliação com nota baixa. Sem essa variável definida, tudo mais continua
# funcionando normalmente — só esses avisos não são enviados (loga no
# servidor em vez de travar qualquer fluxo).
GABRIEL_WHATSAPP_NUMBER=
